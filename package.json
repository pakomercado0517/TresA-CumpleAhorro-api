{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API para Tanda Cumpleañera - Sistema de gestión de grupos de ahorro rotativo",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:watch": "echo \"Error: no test specified\" && exit 1",
    "test:coverage": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "ts-node scripts/run-migrations.ts up",
    "db:migrate:undo": "ts-node scripts/run-migrations.ts down",
    "db:migrate:status": "ts-node scripts/run-migrations.ts status",
    "db:seed": "ts-node scripts/run-seeds.ts",
    "db:seed:undo": "echo 'Seed undo no implementado. Usa db:reset para limpiar la base de datos.'",
    "db:seed:undo:all": "echo 'Seed undo all no implementado. Usa db:reset para limpiar la base de datos.'",
    "db:create": "ts-node scripts/create-database.ts",
    "db:drop": "npx sequelize-cli db:drop",
    "db:reset": "npx sequelize-cli db:drop && pnpm db:create && pnpm db:migrate && pnpm db:seed",
    "test:email": "ts-node scripts/test-email.ts"
  },
  "keywords": [
    "tanda",
    "cumpleaños",
    "api",
    "backend",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendinblue/client": "^3.3.1",
    "@types/nodemailer": "^7.0.4",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "resend": "^6.6.0",
    "sequelize": "^6.35.2",
    "sequelize-typescript": "^2.1.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "umzug": "^3.8.2"
  }
}
